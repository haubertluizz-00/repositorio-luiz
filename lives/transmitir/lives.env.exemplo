# Copie para /etc/lives.env e preencha. NUNCA suba este arquivo preenchido no GitHub.
TIKTOK_USUARIO=paisitottk
# Endereço + chave de transmissão (o TikTok mostra os dois quando você cria a live pelo computador).
# Para mais de uma plataforma, separe por espaço.
DESTINOS="rtmp://COLE-AQUI-O-SERVIDOR/COLE-AQUI-A-CHAVE"
# Senha do jogo (obrigatória se a VPS estiver aberta na internet). Abra o jogo com ?k=ESTA_SENHA
CHAVE_JOGO=troque-por-uma-senha-longa
# Opcional: chave do Euler Stream (deixa a leitura dos presentes mais estável)
# EULER_API_KEY=
# Jogo: escalada (padrão) ou guerra
# JOGO=escalada
# Opcional: música de fundo em loop
# MUSICA=/opt/repositorio-luiz/lives/musica.mp3
